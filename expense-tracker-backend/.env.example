# Never upload a real .env file.

# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/expense_tracker
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=expense_tracker
JWT_SECRET_KEY=replace_with_your_own_local_secret